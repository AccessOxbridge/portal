# =============================================
# ACCESS OXBRIDGE PORTAL — ENVIRONMENT VARIABLES
# =============================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# =============================================


# ─────────────────────────────────────────────
# SUPABASE
# Get these from: https://supabase.com/dashboard → your project → Settings → API
# ─────────────────────────────────────────────

# Your Supabase project URL (e.g. https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key — safe to expose in the browser (used for client-side auth)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Service role key — NEVER expose this publicly, server-side only (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=


# ─────────────────────────────────────────────
# STRIPE
# Get these from: https://dashboard.stripe.com/apikeys
# ─────────────────────────────────────────────

# Secret key — server-side only (starts with sk_live_ or sk_test_)
STRIPE_SECRET_KEY=

# Publishable key — safe to expose in the browser (starts with pk_live_ or pk_test_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret for /api/webhooks/stripe
# Get from: Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=

# Webhook signing secret for /api/webhooks/stripe-connect (Stripe Connect events)
STRIPE_CONNECT_WEBHOOK_SECRET=


# ─────────────────────────────────────────────
# ZOOM
# Get these from: https://marketplace.zoom.us → your Server-to-Server OAuth app
# ─────────────────────────────────────────────

# Account ID from your Zoom Server-to-Server OAuth app
ZOOM_ACCOUNT_ID=

# Client ID from your Zoom Server-to-Server OAuth app
ZOOM_CLIENT_ID=

# Client Secret from your Zoom Server-to-Server OAuth app
ZOOM_CLIENT_SECRET=

# Webhook secret token for /api/webhooks/zoom
# Get from: Zoom Marketplace → your app → Feature → Event Subscriptions → Secret Token
ZOOM_WEBHOOK_SECRET_TOKEN=


# ─────────────────────────────────────────────
# OPENAI
# Get from: https://platform.openai.com/api-keys
# Used for: mentor matching (embeddings) and AI report generation (GPT-4o)
# ─────────────────────────────────────────────

OPEN_AI_API_KEY=


# ─────────────────────────────────────────────
# RESEND
# Get from: https://resend.com/api-keys
# Used for: Email delivery via Supabase Edge Function
# Also needs to be set in Supabase dashboard → Functions → send-email-notifications
# ─────────────────────────────────────────────

RESEND_API_KEY=


# ─────────────────────────────────────────────
# APP CONFIGURATION
# ─────────────────────────────────────────────

# Full URL of the deployed app — used for Stripe redirect URLs
# e.g. https://portal.accessoxbridge.com (or http://localhost:3000 locally)
NEXT_PUBLIC_APP_URL=

# URL of the public-facing homepage/blog site
# e.g. https://www.accessoxbridge.com
NEXT_PUBLIC_HOME_PAGE_URL=

# Environment flag for feature gating
# Set to "dev" to show admin-dev role in signup form
# Leave empty or set to "prod" for production
NEXT_PUBLIC_ENV=


# ─────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────

# Optional secret to secure the /api/cron/reminders endpoint
# Your cron scheduler should send this as an Authorization header
# Generate a random string: openssl rand -hex 32
CRON_SECRET=f5d21a7c729df8b0cb7534ae55896b2bcaff797b02a4283c22f0a2d9baf1b99f
